{
  "name": "avidx-agents",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev:hello": "tsx agents/hello-world/index.ts",
    "dev:kickoff": "tsx agents/planning/index.ts --mode=kickoff",
    "dev:runway": "tsx agents/planning/index.ts --mode=runway",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.90.0",
    "@linear/sdk": "latest",
    "@notionhq/client": "latest",
    "@slack/webhook": "^7.0.5",
    "dotenv": "^16.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
